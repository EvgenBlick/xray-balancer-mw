{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xray-balancer-mw config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "sub_path": { "type": "string", "pattern": "^/" },
    "remnawave_url": { "type": "string", "pattern": "^https?://" },
    "sub_page_url": { "type": "string", "pattern": "^https?://" },
    "sub_domain": { "type": "string", "minLength": 1 },
    "strategy": { "type": "string", "enum": ["leastLoad", "leastload", "leastPing", "leastping", "random", "roundRobin", "roundrobin"] },
    "profile_mode": { "type": "string", "enum": ["balanced", "stable", "aggressive", "debug"] },
    "probe_interval": { "type": "string" },
    "probe_sampling": { "type": "integer", "minimum": 1 },
    "probe_timeout": { "type": "string" },
    "probe_connectivity_url": { "type": "string" },
    "probe_http_method": { "type": "string", "enum": ["HEAD", "GET"] },
    "probe_url": { "type": "string", "pattern": "^https?://" },
    "fastest_probe_url": { "type": "string", "pattern": "^https?://" },
    "checker_url": { "type": "string", "pattern": "^https?://" },
    "node_dns_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service_hostnames": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 500 },
        "node_domain_suffixes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 500 },
        "excluded_endpoints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 500 }
      }
    },
    "fastest_group": { "type": "boolean" },
    "fastest_group_name": { "type": "string", "minLength": 1 },
    "fastest_exclude_groups": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "fastest_fallback": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "node_stats_exclude": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "expand_groups_to_nodes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "hidden_groups": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "hidden_nodes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "auto_groups": { "type": "boolean" },
    "auto_groups_interval_sec": { "type": "integer", "minimum": 1 },
    "node_stats": { "type": "boolean" },
    "node_stats_interval_sec": { "type": "integer", "minimum": 1 },
    "node_stats_stale_sec": { "type": "integer", "minimum": 1 },
    "max_users_per_gb": { "type": "integer", "minimum": 1 },
    "max_users_per_cpu": { "type": "integer", "minimum": 1 },
    "cache_ttl_sec": { "type": "integer", "minimum": 1 },
    "cache_stale_if_error_sec": { "type": "integer", "minimum": 1 },
    "cache_max_entries": { "type": "integer", "minimum": 1 },
    "cache_max_bytes": { "type": "integer", "minimum": 1 },
    "cache_max_item_bytes": { "type": "integer", "minimum": 1 },
    "rate_limit_per_minute": { "type": "integer", "minimum": 1 },
    "rate_limit_burst_10s": { "type": "integer", "minimum": 1 },
    "token_rate_limit_per_minute": { "type": "integer", "minimum": 1 },
    "token_rate_limit_burst_10s": { "type": "integer", "minimum": 1 },
    "token_limiter_max_entries": { "type": "integer", "minimum": 1 },
    "token_limiter_cleanup_batch": { "type": "integer", "minimum": 1 },
    "ip_limiter_max_entries": { "type": "integer", "minimum": 1 },
    "admin_limiter_max_entries": { "type": "integer", "minimum": 1 },
    "max_upstream_concurrency": { "type": "integer", "minimum": 1 },
    "negative_cache_ttl_sec": { "type": "integer", "minimum": 1 },
    "admin_rate_limit_per_minute": { "type": "integer", "minimum": 1 },
    "admin_rate_limit_burst_10s": { "type": "integer", "minimum": 1 },
    "trust_x_forwarded_for": { "type": "boolean" },
    "trusted_proxy_cidrs": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[^/]+/[0-9]{1,3}$" },
      "uniqueItems": true
    },
    "auto_quarantine_enabled": { "type": "boolean" },
    "auto_quarantine_failures": { "type": "integer", "minimum": 1 },
    "auto_quarantine_release_successes": { "type": "integer", "minimum": 1 },
    "auto_quarantine_max_nodes": { "type": "integer", "minimum": 1 },
    "auto_drain_enabled": { "type": "boolean" },
    "auto_drain_failures": { "type": "integer", "minimum": 1 },
    "auto_drain_release_successes": { "type": "integer", "minimum": 1 },
    "auto_drain_load_threshold": { "type": "number", "minimum": 0 },
    "auto_drain_score_penalty": { "type": "number", "minimum": 0 },
    "protection_enabled": { "type": "boolean" },
    "protection_failures": { "type": "integer", "minimum": 1 },
    "protection_release_successes": { "type": "integer", "minimum": 1 },
    "protection_isolation_ttl_sec": { "type": "integer", "minimum": 1 },
    "protection_latency_threshold_ms": { "type": "integer", "minimum": 1 },
    "protection_min_available_nodes": { "type": "integer", "minimum": 1 },
    "emergency_fallback_enabled": { "type": "boolean" },
    "emergency_fallback_max_nodes": { "type": "integer", "minimum": 1 },
    "sticky_enabled": { "type": "boolean" },
    "sticky_mode": { "type": "string", "enum": ["pin", "prefer"] },
    "sticky_new_connections_only": { "type": "boolean" },
    "sticky_ttl_sec": { "type": "integer", "minimum": 1 },
    "sticky_max_entries": { "type": "integer", "minimum": 1 },
    "balancer_load_weight": { "type": "number", "minimum": 0 },
    "balancer_latency_weight": { "type": "number", "minimum": 0 },
    "balancer_max_latency_ms": { "type": "integer", "minimum": 1 },
    "balancer_smoothing_alpha": { "type": "number", "minimum": 0, "maximum": 1 },
    "balancer_hysteresis_delta": { "type": "number", "minimum": 0 },
    "ready_success_window_sec": { "type": "integer", "minimum": 1 },
    "request_timeout_ms": { "type": "integer", "minimum": 1 },
    "max_redirects": { "type": "integer", "minimum": 1 },
    "circuit_breaker_failures": { "type": "integer", "minimum": 1 },
    "circuit_breaker_open_sec": { "type": "integer", "minimum": 1 },
    "admin_token": { "type": "string", "minLength": 8 },
    "api_token": { "type": "string" },
    "panel_auth_cookie": { "type": "string" },
    "warmup_tokens": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" }
    },
    "quarantine_nodes": {
      "type": "array",
      "maxItems": 500,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "auto_quarantine_nodes": {
      "type": "array",
      "maxItems": 500,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "attack_nodes": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["node"],
        "additionalProperties": false,
        "properties": {
          "node": { "type": "string", "minLength": 1, "maxLength": 128 },
          "node_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
          "reason": { "type": "string", "maxLength": 256 },
          "source": { "type": "string", "maxLength": 64 },
          "mode": { "type": "string", "enum": ["manual", "automatic"] },
          "expires_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "groups": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 64 },
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1, "maxLength": 128 },
        "minItems": 0,
        "maxItems": 100
      }
    },
    "group_descriptions": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 64 },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "group_hosts": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 64 },
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1, "maxLength": 128 },
        "maxItems": 500,
        "uniqueItems": true
      }
    }
  }
}
