{
    "port": 4100,
    "sub_path": "/api/sub",

    "strategy": "leastPing",
    "profile_mode": "balanced",
    "probe_interval": "30s",
    "probe_sampling": 1,
    "probe_timeout": "3s",
    "probe_connectivity_url": "https://connectivitycheck.gstatic.com/generate_204",
    "probe_http_method": "HEAD",
    "probe_url": "https://www.gstatic.com/generate_204",
    "fastest_probe_url": "https://ya.ru",

    "fastest_group": true,
    "fastest_group_name": "🏁 🇪🇺 Самые быстрые",
    "fastest_exclude_groups": [],
    "fastest_fallback": ["📱 LTE Special"],
    "node_stats_exclude": [],
    "expand_groups_to_nodes": [],
    "hidden_groups": [],
    "hidden_nodes": [],
    "auto_groups": false,
    "auto_groups_interval_sec": 300,

    "node_stats": false,
    "node_stats_interval_sec": 120,
    "node_stats_stale_sec": 360,
    "max_users_per_gb": 20,
    "max_users_per_cpu": 40,
    "cache_ttl_sec": 300,
    "cache_stale_if_error_sec": 1800,
    "cache_max_entries": 1000,
    "cache_max_bytes": 134217728,
    "cache_max_item_bytes": 10485760,
    "rate_limit_per_minute": 120,
    "rate_limit_burst_10s": 30,
    "token_rate_limit_per_minute": 240,
    "token_rate_limit_burst_10s": 60,
    "ip_limiter_max_entries": 10000,
    "admin_limiter_max_entries": 2000,
    "max_upstream_concurrency": 32,
    "negative_cache_ttl_sec": 30,
    "admin_rate_limit_per_minute": 60,
    "admin_rate_limit_burst_10s": 20,
    "trust_x_forwarded_for": false,
    "auto_quarantine_enabled": false,
    "auto_quarantine_failures": 3,
    "auto_quarantine_release_successes": 2,
    "auto_quarantine_max_nodes": 100,
    "auto_drain_enabled": false,
    "auto_drain_failures": 2,
    "auto_drain_release_successes": 2,
    "auto_drain_load_threshold": 0.85,
    "auto_drain_score_penalty": 0.6,
    "protection_enabled": false,
    "protection_failures": 2,
    "protection_release_successes": 3,
    "protection_isolation_ttl_sec": 300,
    "protection_latency_threshold_ms": 1500,
    "protection_min_available_nodes": 1,
    "emergency_fallback_enabled": true,
    "emergency_fallback_max_nodes": 1,
    "sticky_enabled": true,
    "sticky_mode": "prefer",
    "sticky_new_connections_only": true,
    "sticky_ttl_sec": 300,
    "sticky_max_entries": 10000,
    "balancer_load_weight": 0.4,
    "balancer_latency_weight": 0.6,
    "balancer_max_latency_ms": 300,
    "balancer_smoothing_alpha": 0.35,
    "balancer_hysteresis_delta": 0.08,
    "ready_success_window_sec": 300,
    "request_timeout_ms": 10000,
    "max_redirects": 3,
    "circuit_breaker_failures": 6,
    "circuit_breaker_open_sec": 30,
    "warmup_tokens": [],
    "quarantine_nodes": [],
    "auto_quarantine_nodes": [],
    "attack_nodes": [],

    "groups": {
        "🇫🇮 Finland": ["Finland"],
        "🇩🇪 Germany": ["German"],
        "🇳🇱 Netherlands": ["Netherlands"],
        "📱 LTE Special": ["LTE"]
